{
  "name": "bidcheck-g2b",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "db:migrate:local": "wrangler d1 migrations apply bidcheck --local -c wrangler.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply bidcheck --remote -c wrangler.jsonc",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "cfb": "^1.2.2",
    "clsx": "^2.1.1",
    "docx": "^9.9.0",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "hono": "^4.13.13",
    "lucide-react": "^1.52.0",
    "marked": "^18.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.0",
    "@cloudflare/workers-types": "^5.20261007.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.87.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.3",
    "wrangler": "^4.148.0"
  }
}
